# ──────────────────────────────────────────────
# InsightFlow IA — configuración de la IA
# ──────────────────────────────────────────────
# Copia este archivo a .env y rellena tu clave.
#
# CÓMO OBTENER LA CLAVE DE GEMINI (GRATIS):
# 1. Ve a https://aistudio.google.com/app/apikey
# 2. Inicia sesión con tu cuenta Google
# 3. Clic en "Create API Key"
# 4. Copia la clave y pégala aquí abajo
# ──────────────────────────────────────────────

GEMINI_API_KEY=tu_clave_aqui

# Modelo a usar (opciones: gemini-1.5-flash · gemini-1.5-pro · gemini-2.0-flash)
# gemini-1.5-flash  → rápido, gratis (1500 req/día)
# gemini-2.0-flash  → más listo, también gratis en cuota gratuita
GEMINI_MODEL=gemini-2.0-flash
